server {
    listen {{ web_port }} default_server;

    server_name {{ web_server_name }};

    root {{ web_root }};

    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /private/ {
        auth_basic "Zone protegee";
        auth_basic_user_file /etc/nginx/.htpasswd;

        try_files $uri $uri/ =404;
    }
}
